# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/faro

# Google APIs (cuenta de servicio) — Search Console, GA4, Sheets/Drive
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}

# Squirrly SEO / Ubersuggest
KEYWORDS_API_URL=https://api.example.com/keywords
KEYWORDS_API_KEY=

# Security Ninja
SECURITY_NINJA_API_KEY=

# Email (SMTP) — informes de cliente y alertas
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=admin@example.com

# App
PORT=3000
