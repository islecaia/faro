<%
const variables = [
  { key: 'sitio', label: 'Nombre del sitio' },
  { key: 'periodo', label: 'Periodo del informe' },
  { key: 'impresiones', label: 'Impresiones' },
  { key: 'clics', label: 'Clics' },
  { key: 'visitas', label: 'Visitas' },
  { key: 'direct', label: 'Tráfico directo (%)' },
  { key: 'organico', label: 'Tráfico orgánico (%)' },
  { key: 'rss', label: 'Tráfico RSS (%)' },
  { key: 'referrals', label: 'Tráfico de referrals (%)' },
  { key: 'other', label: 'Otro tráfico (%)' },
  { key: 'rendimiento_movil', label: 'Rendimiento móvil' },
  { key: 'rendimiento_desktop', label: 'Rendimiento desktop' },
  { key: 'ranking', label: 'Ranking actual' },
  { key: 'evolucion', label: 'Evolución del ranking' },
  { key: 'oportunidad_1', label: 'Oportunidad 1' },
  { key: 'oportunidad_2', label: 'Oportunidad 2' },
  { key: 'oportunidad_3', label: 'Oportunidad 3' },
  { key: 'incidencias', label: 'Incidencias resueltas' },
  { key: 'paso_1', label: 'Paso / recomendación 1' },
  { key: 'paso_2', label: 'Paso / recomendación 2' },
  { key: 'paso_3', label: 'Paso / recomendación 3' },
  { key: 'mensaje', label: 'Mensaje adicional' },
];
%>

<h1 class="screen-heading">Plantilla de email</h1>

<% if (justSaved) { %>
  <div class="alert alert-success">
    <i class="ph ph-check-circle"></i>
    <div>Plantilla guardada correctamente.</div>
  </div>
<% } %>

<div style="display:flex; gap: var(--space-4); align-items:flex-start;">
  <form id="template-form" action="/template" method="post" style="flex: 1;">
    <div class="field">
      <label>Contenido de la plantilla</label>
      <div id="editor" style="background:#ffffff; color:#222222; min-height:400px;"></div>
      <input type="hidden" id="body-input" name="body">
    </div>
    <div>
      <button type="submit" class="btn btn-primary"><i class="ph ph-check"></i> Guardar plantilla</button>
    </div>
  </form>

  <div class="card" style="width: 280px; flex-shrink: 0;">
    <p class="section-label">Variables disponibles</p>
    <p class="caption" style="margin-bottom: var(--space-3);">Haz clic en una variable para insertarla en el cursor.</p>
    <div style="display:flex; flex-direction:column; gap: var(--space-2);">
      <% variables.forEach(v => { %>
        <button type="button" class="btn btn-ghost template-var-btn" data-var="<%= v.key %>" style="justify-content:flex-start; text-align:left;">
          <code><%- '{{' + v.key + '}}' %></code> — <%= v.label %>
        </button>
      <% }) %>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Quill === 'undefined') {
      console.error('Quill no se ha cargado (revisa la conexión al CDN).');
      return;
    }

    var quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          ['bold', 'italic', 'underline'],
          [{ color: [] }, { background: [] }],
          [{ font: [] }],
          [{ size: ['small', false, 'large', 'huge'] }],
          [{ list: 'ordered' }, { list: 'bullet' }],
          [{ align: [] }],
          ['link'],
        ],
      },
    });

    // JSON.stringify (con los "<" pasados a <) evita que un cuerpo guardado con
    // comillas, saltos de línea reales o un "</script>" incrustado rompa este bloque.
    var initialBody = <%- JSON.stringify(body || '').replace(/</g, '\\u003c') %>;
    if (initialBody) {
      quill.root.innerHTML = initialBody;
    }

    document.querySelectorAll('.template-var-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var placeholder = '{{' + btn.getAttribute('data-var') + '}}';
        var range = quill.getSelection(true);
        var index = range ? range.index : quill.getLength();
        quill.insertText(index, placeholder);
        quill.setSelection(index + placeholder.length);
      });
    });

    document.getElementById('template-form').addEventListener('submit', function () {
      document.getElementById('body-input').value = quill.root.innerHTML;
    });
  });
</script>
