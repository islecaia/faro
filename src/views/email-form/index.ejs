<h1 class="screen-heading">Formulario de informe — <%= site.name %></h1>

<form action="/email-form/<%= record.id %>/send" method="post" class="form-grid">
  <p class="section-label">Cabecera</p>
  <div class="field">
    <label>Email del cliente</label>
    <input type="email" value="<%= site.client_email %>" disabled>
  </div>

  <p class="section-label">#3 Tráfico y visitas — Impresiones</p>
  <div class="field">
    <label for="impressions">Impresiones del mes</label>
    <input type="number" id="impressions" name="impressions" value="<%= record.impressions %>" required>
  </div>
  <div class="field">
    <label for="impressions_variation">% variación vs mes anterior</label>
    <input type="text" id="impressions_variation" name="impressions_variation" value="<%= impressions_variation %>" placeholder="+122">
  </div>

  <p class="section-label">#3 Tráfico y visitas — Clics</p>
  <div class="field">
    <label for="clicks">Clics del mes</label>
    <input type="number" id="clicks" name="clicks" value="<%= record.clicks %>" required>
  </div>
  <div class="field">
    <label for="clicks_variation">% variación vs mes anterior</label>
    <input type="text" id="clicks_variation" name="clicks_variation" value="<%= clicks_variation %>" placeholder="-31">
  </div>

  <p class="section-label">#1 / #4 Desglose de canales de tráfico</p>
  <div class="field"><label for="pct_direct">Directas (%)</label><input type="number" step="0.01" id="pct_direct" name="pct_direct" value="<%= record.pct_direct %>"></div>
  <div class="field"><label for="pct_organic">Orgánicas (%)</label><input type="number" step="0.01" id="pct_organic" name="pct_organic" value="<%= record.pct_organic %>"></div>
  <div class="field"><label for="pct_social">Redes sociales (%)</label><input type="number" step="0.01" id="pct_social" name="pct_social" value="<%= record.pct_social %>"></div>
  <div class="field"><label for="pct_referral">Referrals (%)</label><input type="number" step="0.01" id="pct_referral" name="pct_referral" value="<%= record.pct_referral %>"></div>
  <div class="field"><label for="pct_other">Otras (%)</label><input type="number" step="0.01" id="pct_other" name="pct_other" value="<%= record.pct_other %>"></div>

  <p class="section-label">#5 Ranking actual</p>
  <div class="field">
    <label for="ranking_trend">Tendencia</label>
    <select id="ranking_trend" name="ranking_trend">
      <option value="Mejorando gradualmente">Mejorando gradualmente</option>
      <option value="Bajando ligeramente">Bajando ligeramente</option>
      <option value="Manteniéndose estable">Manteniéndose estable</option>
    </select>
  </div>
  <div class="field">
    <label for="ranking_comment">Comentario sobre el ranking</label>
    <textarea id="ranking_comment" name="ranking_comment" rows="2"></textarea>
  </div>

  <p class="section-label">#5 Oportunidades SEO identificadas</p>
  <div class="field"><label for="opportunity_1">Oportunidad 1</label><input type="text" id="opportunity_1" name="opportunity_1"></div>
  <div class="field"><label for="opportunity_2">Oportunidad 2</label><input type="text" id="opportunity_2" name="opportunity_2"></div>
  <div class="field"><label for="opportunity_3">Oportunidad 3</label><input type="text" id="opportunity_3" name="opportunity_3"></div>

  <p class="section-label">#5 Rendimiento técnico</p>
  <div class="field"><label for="score_mobile">Puntuación Mobile</label><input type="number" id="score_mobile" name="score_mobile" value="<%= record.score_mobile %>"></div>
  <div class="field">
    <label for="rating_mobile">Calificación Mobile</label>
    <select id="rating_mobile" name="rating_mobile">
      <option value="malo">Malo</option><option value="mejorable">Mejorable</option>
      <option value="bueno">Bueno</option><option value="excelente">Excelente</option>
    </select>
  </div>
  <div class="field"><label for="score_desktop">Puntuación Desktop</label><input type="number" id="score_desktop" name="score_desktop" value="<%= record.score_desktop %>"></div>
  <div class="field">
    <label for="rating_desktop">Calificación Desktop</label>
    <select id="rating_desktop" name="rating_desktop">
      <option value="malo">Malo</option><option value="mejorable">Mejorable</option>
      <option value="bueno">Bueno</option><option value="excelente">Excelente</option>
    </select>
  </div>

  <p class="section-label">#2 Seguridad y estado general</p>
  <div class="field"><label for="security_status">Estado general del sitio</label><input type="text" id="security_status" name="security_status" placeholder="Segura, sin incidencias"></div>
  <div class="field"><label for="attacks_blocked">Ataques bloqueados</label><input type="number" id="attacks_blocked" name="attacks_blocked" value="<%= record.attacks_blocked %>"></div>
  <div class="field"><label for="threats_count">Amenazas detectadas</label><input type="number" id="threats_count" name="threats_count" value="<%= record.threats_count %>"></div>
  <div class="field"><label for="notes">Notas para el cliente</label><textarea id="notes" name="notes" rows="3"></textarea></div>

  <div>
    <button type="submit" class="btn btn-primary"><i class="ph ph-envelope"></i> Enviar informe</button>
    <a href="/reports/<%= record.id %>" class="btn btn-ghost">Cancelar</a>
  </div>
</form>
