<%
// Escala oficial de calificación PageSpeed: 0-49 malo, 50-74 mejorable, 75-89 bueno, 90-100 excelente.
function pageSpeedRating(score) {
  const value = Number(score);
  if (value >= 90) return 'excelente';
  if (value >= 75) return 'bueno';
  if (value >= 50) return 'mejorable';
  return 'malo';
}
function ratingOptions(score) {
  const selected = pageSpeedRating(score);
  const labels = { malo: 'Malo', mejorable: 'Mejorable', bueno: 'Bueno', excelente: 'Excelente' };
  return Object.entries(labels)
    .map(([value, label]) => `<option value="${value}"${value === selected ? ' selected' : ''}>${label}</option>`)
    .join('');
}
%>

<h1 class="screen-heading">Componer informe — <%= site.name %></h1>

<% if (justSent) { %>
  <div class="alert alert-success">
    <i class="ph ph-check-circle"></i>
    <div>Informe enviado correctamente a <%= sentTo %>.</div>
  </div>
<% } %>

<% if (justError) { %>
  <div class="alert alert-error">
    <i class="ph ph-warning-circle"></i>
    <div>No se pudo enviar el informe. Revisa la configuración SMTP e inténtalo de nuevo.</div>
  </div>
<% } %>

<form id="compose-form" action="/reports/<%= record.id %>/preview" method="post" class="form-grid">
  <p class="section-label">Cabecera</p>
  <div class="field">
    <label for="nombre">Nombre del cliente</label>
    <input type="text" id="nombre" name="nombre">
  </div>
  <div class="field">
    <label for="to">Email destinatario</label>
    <input type="email" id="to" name="to" value="<%= site.client_email %>" required>
  </div>

  <p class="section-label">Tráfico — Impresiones</p>
  <div class="field">
    <label for="impressions">Impresiones del mes</label>
    <input type="number" id="impressions" name="impressions" value="<%= record.impressions %>">
  </div>
  <div class="field">
    <label for="impressions_variation">% variación vs mes anterior</label>
    <input type="text" id="impressions_variation" name="impressions_variation" value="<%= impressionsVariation %>" placeholder="+22">
  </div>

  <p class="section-label">Tráfico — Clics</p>
  <div class="field">
    <label for="clicks">Clics del mes</label>
    <input type="number" id="clicks" name="clicks" value="<%= record.clicks %>">
  </div>
  <div class="field">
    <label for="clicks_variation">% variación vs mes anterior</label>
    <input type="text" id="clicks_variation" name="clicks_variation" value="<%= clicksVariation %>" placeholder="-5">
  </div>

  <p class="section-label">Canales</p>
  <div class="field"><label for="channel_direct">Direct (%)</label><input type="number" step="0.01" id="channel_direct" name="channel_direct" value="<%= record.pct_direct %>"></div>
  <div class="field"><label for="channel_organic">Organic Search (%)</label><input type="number" step="0.01" id="channel_organic" name="channel_organic" value="<%= record.pct_organic %>"></div>
  <div class="field"><label for="channel_rss">RSS (%)</label><input type="number" step="0.01" id="channel_rss" name="channel_rss" value="<%= record.pct_social %>"></div>
  <div class="field"><label for="channel_referrals">Referrals (%)</label><input type="number" step="0.01" id="channel_referrals" name="channel_referrals" value="<%= record.pct_referral %>"></div>
  <div class="field"><label for="channel_other">Other (%)</label><input type="number" step="0.01" id="channel_other" name="channel_other" value="<%= record.pct_other %>"></div>

  <p class="section-label">Ranking</p>
  <div class="field">
    <label for="ranking_current">Ranking actual</label>
    <input type="text" id="ranking_current" name="ranking_current" placeholder="p. ej. posición media 8">
  </div>
  <div class="field">
    <label for="ranking_evolution">Evolución vs mes anterior</label>
    <select id="ranking_evolution" name="ranking_evolution">
      <option value="Mejorando gradualmente">Mejorando gradualmente</option>
      <option value="Bajando ligeramente">Bajando ligeramente</option>
      <option value="Manteniéndose estable">Manteniéndose estable</option>
    </select>
  </div>

  <p class="section-label">Rendimiento técnico — Móvil</p>
  <div class="field"><label for="score_mobile">Puntuación (sobre 100)</label><input type="number" id="score_mobile" name="score_mobile" value="<%= record.score_mobile %>"></div>
  <div class="field">
    <label for="rating_mobile">Calificación</label>
    <select id="rating_mobile" name="rating_mobile">
      <%- ratingOptions(record.score_mobile) %>
    </select>
  </div>

  <p class="section-label">Rendimiento técnico — Desktop</p>
  <div class="field"><label for="score_desktop">Puntuación (sobre 100)</label><input type="number" id="score_desktop" name="score_desktop" value="<%= record.score_desktop %>"></div>
  <div class="field">
    <label for="rating_desktop">Calificación</label>
    <select id="rating_desktop" name="rating_desktop">
      <%- ratingOptions(record.score_desktop) %>
    </select>
  </div>

  <p class="section-label">Oportunidades identificadas</p>
  <div class="field"><label for="opportunity_1">Oportunidad 1</label><input type="text" id="opportunity_1" name="opportunity_1"></div>
  <div class="field"><label for="opportunity_2">Oportunidad 2</label><input type="text" id="opportunity_2" name="opportunity_2"></div>
  <div class="field"><label for="opportunity_3">Oportunidad 3</label><input type="text" id="opportunity_3" name="opportunity_3"></div>

  <p class="section-label">Incidencias resueltas</p>
  <div class="field">
    <label for="incidents_resolved">Incidencias resueltas este mes</label>
    <textarea id="incidents_resolved" name="incidents_resolved" rows="3"></textarea>
  </div>

  <p class="section-label">Próximos pasos y recomendaciones</p>
  <div class="field">
    <label for="next_steps">Próximos pasos</label>
    <textarea id="next_steps" name="next_steps" rows="3"></textarea>
  </div>
  <div class="field"><label for="recommendation_1">Recomendación 1</label><input type="text" id="recommendation_1" name="recommendation_1"></div>
  <div class="field"><label for="recommendation_2">Recomendación 2</label><input type="text" id="recommendation_2" name="recommendation_2"></div>
  <div class="field"><label for="recommendation_3">Recomendación 3</label><input type="text" id="recommendation_3" name="recommendation_3"></div>

  <p class="section-label">Mensaje adicional</p>
  <div class="field">
    <label for="additional_message">Mensaje adicional para el cliente</label>
    <textarea id="additional_message" name="additional_message" rows="3"></textarea>
  </div>

  <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2);">
    <input type="checkbox" id="consent_updates" name="consent_updates" value="1" style="width:auto;">
    <label for="consent_updates" style="text-transform:none; letter-spacing:normal;">Acepto recibir mi guía y comunicaciones de valor</label>
  </div>
  <div class="field" style="flex-direction: row; align-items: center; gap: var(--space-2);">
    <input type="checkbox" id="consent_privacy" name="consent_privacy" value="1" style="width:auto;">
    <label for="consent_privacy" style="text-transform:none; letter-spacing:normal;">Acepto la Política de Privacidad y Términos</label>
  </div>

  <div>
    <button type="submit" id="compose-send-btn" class="btn btn-primary">
      <i class="ph ph-eye"></i> <span id="compose-send-btn-label">Vista previa</span>
    </button>
    <a href="/reports/<%= record.id %>" class="btn btn-ghost">Cancelar</a>
  </div>
</form>

<style>
  .btn-spinner {
    display: inline-block;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: currentColor;
    border-radius: 50%;
    vertical-align: -2px;
    animation: compose-btn-spin 700ms linear infinite;
  }
  @keyframes compose-btn-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  (function () {
    var form = document.getElementById('compose-form');
    var btn = document.getElementById('compose-send-btn');
    if (!form || !btn) return;

    // Envío normal del formulario (sin fetch): el POST navega a /preview, que renderiza una
    // página nueva, así que no hace falta restaurar el botón aquí.
    form.addEventListener('submit', function () {
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-spinner"></span> Generando vista previa…';
    });
  })();
</script>
