<%
const sourceOptions = [
  '', 'Google Site Kit', 'Squirrly SEO', 'Google Rankings', 'Rybbit',
  'Ubersuggest', 'PageSpeed Insights', 'Security Ninja',
];
function renderSourceSelect(name, label) {
  const options = sourceOptions.map((opt) => {
    const optLabel = opt === '' ? '— Sin configurar —' : opt;
    return `<option value="${opt}">${optLabel}</option>`;
  }).join('');
  return `
    <div class="field">
      <label for="${name}">${label}</label>
      <select id="${name}" name="${name}">${options}</select>
    </div>`;
}
%>

<h1 class="screen-heading">Añadir sitio</h1>

<form action="/sites" method="post" class="form-grid">
  <div class="field">
    <label for="name">Nombre del sitio / cliente</label>
    <input type="text" id="name" name="name" required>
  </div>

  <div class="field">
    <label for="url">URL</label>
    <input type="url" id="url" name="url" placeholder="https://ejemplo.com" required>
  </div>

  <div class="field">
    <label for="client_email">Email del cliente</label>
    <input type="email" id="client_email" name="client_email" required>
  </div>

  <div class="field">
    <label for="contact_name">Nombre del contacto</label>
    <input type="text" id="contact_name" name="contact_name">
  </div>

  <p class="section-label">Fuentes de datos</p>

  <%- renderSourceSelect('source_clicks', 'Fuente de impresiones/clics') %>
  <%- renderSourceSelect('source_visits', 'Fuente de visitas') %>
  <%- renderSourceSelect('source_keywords', 'Fuente de keywords') %>
  <%- renderSourceSelect('source_pagespeed', 'Fuente de rendimiento') %>
  <%- renderSourceSelect('source_security', 'Fuente de seguridad') %>

  <div>
    <button type="submit" class="btn btn-primary"><i class="ph ph-check"></i> Guardar sitio</button>
    <a href="/sites" class="btn btn-ghost">Cancelar</a>
  </div>
</form>
