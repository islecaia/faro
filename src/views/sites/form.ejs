<h1 class="screen-heading">Añadir sitio</h1>

<form action="/sites" method="post" class="form-grid">
  <div class="field">
    <label for="name">Nombre del sitio / cliente</label>
    <input type="text" id="name" name="name" required>
  </div>

  <div class="field">
    <label for="url">URL</label>
    <input type="url" id="url" name="url" placeholder="https://ejemplo.com" required>
  </div>

  <div class="field">
    <label for="client_email">Email del cliente</label>
    <input type="email" id="client_email" name="client_email" required>
  </div>

  <p class="section-label">Fuentes de datos</p>
  <p class="caption">PageSpeed Insights no necesita identificador — usa la URL del sitio.</p>

  <div class="field">
    <label for="sc_property_id">Search Console — property ID</label>
    <input type="text" id="sc_property_id" name="sc_property_id">
  </div>

  <div class="field">
    <label for="ga_property_id">GA4 Analytics — property ID</label>
    <input type="text" id="ga_property_id" name="ga_property_id">
  </div>

  <div class="field">
    <label for="keywords_site_id">Keywords (Squirrly/Ubersuggest) — site ID</label>
    <input type="text" id="keywords_site_id" name="keywords_site_id">
  </div>

  <div class="field">
    <label for="security_site_id">Security Ninja — site ID</label>
    <input type="text" id="security_site_id" name="security_site_id">
  </div>

  <div>
    <button type="submit" class="btn btn-primary"><i class="ph ph-check"></i> Guardar sitio</button>
    <a href="/sites" class="btn btn-ghost">Cancelar</a>
  </div>
</form>
