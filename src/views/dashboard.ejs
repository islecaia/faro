<%
function sourceTooltip(sourcesUsed, category) {
  const entry = sourcesUsed && sourcesUsed[category];
  if (!entry || !entry.tool) return '';
  return ` data-tooltip="${entry.tool} · ${entry.status}"`;
}
// Solo se marca el borde cuando hay un fallo de fuente; en cualquier otro caso no hay línea
// de color. Se acepta tanto 'failed' (valor que usa sources_status) como 'fallida' (valor
// que usa sources_used), por si en el futuro se compara cualquiera de los dos campos aquí.
function rowBorderColor(row) {
  const statuses = Object.values(row.sources_status || {});
  const hasError = statuses.some((status) => status === 'failed' || status === 'fallida');
  return hasError ? 'var(--status-error)' : '';
}
%>

<div style="display:flex; align-items:center; justify-content:space-between;">
  <h1 class="screen-heading">Dashboard</h1>
  <div style="display:flex; align-items:center; gap: var(--space-3);">
    <form method="get" id="site-filter-form">
      <select name="site_id" id="site-filter">
        <option value="">Todos los sitios</option>
        <% sites.forEach(site => { %>
          <option value="<%= site.id %>" <%= String(selectedSiteId) === String(site.id) ? 'selected' : '' %>>
            <%= site.name %><%= site.status === 'inactive' ? ' (baja)' : '' %>
          </option>
        <% }) %>
      </select>
    </form>
    <a id="btn-compose" href="#" class="btn btn-primary" hidden>Componer informe</a>
  </div>
</div>

<% if (!historical.length) { %>
  <div class="card empty-state">
    Aún no hay registros para este sitio.<br>
    Genera el primer informe mensual para empezar el histórico.
  </div>
<% } else { %>
  <!-- Estas tarjetas reflejan la fila seleccionada en la tabla de histórico (ver selectRow,
       al final del archivo), no un valor fijo calculado en el servidor. -->
  <div class="kpi-grid">
    <div class="kpi-card" data-metric="impressions" style="border-left: 4px solid #4361ee;">
      <div class="kpi-card-label section-label"><i class="ph ph-eye"></i> IMPRESIONES</div>
      <div class="kpi-card-value" id="kpi-value-impressions">—</div>
    </div>
    <div class="kpi-card" data-metric="clicks" style="border-left: 4px solid #7209b7;">
      <div class="kpi-card-label section-label"><i class="ph ph-cursor-click"></i> CLICS</div>
      <div class="kpi-card-value" id="kpi-value-clicks">—</div>
    </div>
    <div class="kpi-card" data-metric="visits" style="border-left: 4px solid #2a9d8f;">
      <div class="kpi-card-label section-label"><i class="ph ph-users"></i> VISITAS</div>
      <div class="kpi-card-value" id="kpi-value-visits">—</div>
    </div>
    <div class="kpi-card" data-metric="score_mobile" style="border-left: 4px solid #e9c46a;">
      <div class="kpi-card-label section-label"><i class="ph ph-gauge"></i> RENDIMIENTO MOBILE</div>
      <div class="kpi-card-value" id="kpi-value-score_mobile">—</div>
    </div>
    <div class="kpi-card" data-metric="score_desktop" style="border-left: 4px solid #f4a261;">
      <div class="kpi-card-label section-label"><i class="ph ph-gauge"></i> RENDIMIENTO DESKTOP</div>
      <div class="kpi-card-value" id="kpi-value-score_desktop">—</div>
    </div>
    <div class="kpi-card" data-metric="ps_mobile" style="border-left: 4px solid #06d6a0;">
      <div class="kpi-card-label section-label"><i class="ph ph-gauge"></i> PS MOBILE</div>
      <div class="kpi-card-value" id="kpi-value-ps_mobile">—</div>
    </div>
    <div class="kpi-card" data-metric="ps_desktop" style="border-left: 4px solid #118ab2;">
      <div class="kpi-card-label section-label"><i class="ph ph-gauge"></i> PS DESKTOP</div>
      <div class="kpi-card-value" id="kpi-value-ps_desktop">—</div>
    </div>
    <div class="kpi-card" data-metric="threats_count" style="border-left: 4px solid #e63946;">
      <div class="kpi-card-label section-label"><i class="ph ph-shield-warning"></i> AMENAZAS</div>
      <div class="kpi-card-value" id="kpi-value-threats_count">—</div>
    </div>
  </div>
<% } %>

<div>
  <p class="section-label">Histórico de registros</p>
  <% if (!historical.length) { %>
    <div class="card empty-state">No hay registros históricos todavía. Genera el primer informe de un sitio para empezar.</div>
  <% } else { %>
    <div class="table-wrap">
      <table id="historical-table">
        <thead>
          <tr>
            <th>Sitio</th><th>Fecha</th><th>Impresiones</th><th>Clics</th><th>Visitas</th>
            <th>% Directo</th><th>% Orgánico</th><th>% Social</th><th>% Referral</th><th>% Otro</th>
            <th>PS Mobile</th><th>PS Desktop</th><th>Ataques</th><th>Amenazas</th>
          </tr>
        </thead>
        <tbody>
          <% historical.forEach(row => { %>
            <tr data-record-id="<%= row.id %>" class="<%= Object.values(row.sources_status || {}).includes('failed') ? 'row-error' : '' %>">
              <% const borderColor = rowBorderColor(row); %>
              <td style="font-family: var(--font-ui);<%= borderColor ? ` border-left: 3px solid ${borderColor};` : '' %>"><%= row.site_name %></td>
              <td><%= new Date(row.period).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
              <td<%- sourceTooltip(row.sources_used, 'clicks') %> data-col="impressions" data-value="<%= row.impressions %>"><%= row.impressions %></td>
              <td<%- sourceTooltip(row.sources_used, 'clicks') %> data-col="clicks" data-value="<%= row.clicks %>"><%= row.clicks %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-col="visits" data-value="<%= row.visits %>"><%= row.visits %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-value="<%= row.pct_direct %>"><%= row.pct_direct %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-value="<%= row.pct_organic %>"><%= row.pct_organic %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-value="<%= row.pct_social %>"><%= row.pct_social %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-value="<%= row.pct_referral %>"><%= row.pct_referral %></td>
              <td<%- sourceTooltip(row.sources_used, 'visits') %> data-value="<%= row.pct_other %>"><%= row.pct_other %></td>
              <td<%- sourceTooltip(row.sources_used, 'pagespeed') %> data-col="score_mobile ps_mobile" data-value="<%= row.score_mobile %>"><%= row.score_mobile %></td>
              <td<%- sourceTooltip(row.sources_used, 'pagespeed') %> data-col="score_desktop ps_desktop" data-value="<%= row.score_desktop %>"><%= row.score_desktop %></td>
              <td<%- sourceTooltip(row.sources_used, 'security') %> data-value="<%= row.attacks_blocked %>"><%= row.attacks_blocked %></td>
              <td<%- sourceTooltip(row.sources_used, 'security') %> data-col="threats_count" data-value="<%= row.threats_count %>"><%= row.threats_count %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<style>
  /* Tooltips de celda (CSS puro, sin librerías): indican qué herramienta se usó para ese
     dato concreto en la generación de ese informe, y si tuvo éxito. */
  td[data-tooltip] {
    position: relative;
    cursor: help;
  }

  td[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: var(--bg-panel);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    padding: 6px 10px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 150ms ease;
    z-index: 10;
  }

  td[data-tooltip]:hover::after {
    opacity: 1;
    visibility: visible;
  }

  /* Selección de fila en la tabla de histórico: fondo distinto + borde izquierdo más grueso. */
  #historical-table tbody tr {
    cursor: pointer;
  }

  #historical-table tbody tr.row-selected td {
    background: var(--bg-panel);
  }

  /* El color y el ancho base del borde (solo presente si hay error de fuente) vienen de un
     style inline por fila; !important es necesario para que el grosor de selección gane
     sobre ese inline sin tener que recalcular ni repetir el color aquí. */
  #historical-table tbody tr.row-selected td:first-child {
    border-left-width: 5px !important;
  }
</style>

<div>
  <p class="section-label">Oportunidades SEO</p>
  <% if (!opportunities.length) { %>
    <div class="card empty-state">No hay palabras clave en posición 4–10 en este momento.</div>
  <% } else { %>
    <div class="card" style="display:flex; flex-direction:column; gap: var(--space-2);">
      <% opportunities.forEach(kw => { %>
        <div style="display:flex; align-items:center; gap: var(--space-3);">
          <span class="badge badge-oportunidad">OPORTUNIDAD</span>
          <span style="font-family: var(--font-mono);"><%= kw.keyword %></span>
          <span class="caption"><%= kw.site_name %> · posición <%= kw.position %><%= kw.search_volume ? ' · ' + kw.search_volume + ' búsquedas/mes' : '' %></span>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
  // Marca tr como la fila seleccionada y vuelca sus data-value en las tarjetas de resumen
  // que compartan el mismo nombre de métrica (data-col en el <td> <-> data-metric/id en la tarjeta).
  function selectRow(tr) {
    if (!tr) return;

    document.querySelectorAll('#historical-table tbody tr').forEach(function (r) {
      r.classList.remove('row-selected');
    });
    tr.classList.add('row-selected');

    tr.querySelectorAll('td[data-col]').forEach(function (td) {
      // data-col puede llevar varios nombres separados por espacio cuando una misma celda
      // alimenta más de una tarjeta (p. ej. "score_mobile ps_mobile").
      td.getAttribute('data-col').split(/\s+/).forEach(function (metric) {
        var target = document.getElementById('kpi-value-' + metric);
        if (target) {
          target.textContent = td.getAttribute('data-value');
        }
      });
    });

    var composeBtn = document.getElementById('btn-compose');
    if (composeBtn && tr.dataset.recordId) {
      composeBtn.href = '/reports/' + tr.dataset.recordId + '/compose';
      composeBtn.hidden = false;
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    var rows = document.querySelectorAll('#historical-table tbody tr');
    rows.forEach(function (row) {
      row.addEventListener('click', function () {
        selectRow(this);
      });
    });
    if (rows.length) {
      selectRow(rows[0]);
    }
  });
</script>
